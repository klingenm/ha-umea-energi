{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mise run *)",
      "Bash(mise tasks *)",
      "Bash(mise ls *)",
      "Bash(mise install)",
      "Bash(mise outdated *)",
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uv tree *)",
      "Bash(uv run pytest *)",
      "Bash(uv check *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(but status *)",
      "Bash(but diff *)",
      "Bash(but show *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
